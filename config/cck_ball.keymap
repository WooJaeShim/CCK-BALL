#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/* 중복 정의 방지 처리 */
#ifndef ZMK_POINTING_DEFAULT_MOVE_VAL
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000
#endif
#ifndef ZMK_POINTING_DEFAULT_SCRL_VAL
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12
#endif
/* * 최신 ZMK에서는 프로세서 선언 방식이 엄격합니다.
 * 에러 방지를 위해 기존 zip_xy_scaler 선언을 제거하고 기본값을 사용합니다.
 */

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <300>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    /* 엔코더 비헤이비어 정의 */
    behaviors {
        scroll_v: scroll_v {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <30>;
        };
        scroll_h: scroll_h {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
            tap-ms = <30>;
        };
    };

    macros {
        alt_ctrl_del: alt_ctrl_del {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &kp LALT &kp LCTRL &kp DEL>, <&macro_release &kp LALT &kp LCTRL &kp DEL>;
        };

        pw_macro: pw_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp G &kp G &kp N2 &kp N3 &kp N6 &kp N4 &kp Z &kp R &kp N3 &kp POUND>;
        };

        x_admin: x_admin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp X &kp MINUS &kp A &kp D &kp M &kp I &kp N>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC           &kp N1        &kp N2        &kp N3      &kp N4     &kp N5     &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp BSPC
&kp TAB           &kp Q         &kp W         &kp E       &kp R      &kp T      &kp Y      &kp U      &kp I      &kp O      &kp P      &kp BSLH
&kp CAPSLOCK      &kp A         &lt 4 S       &kp D       &lt 3 F    &kp G      &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
&kp LSHFT         &kp Z         &kp X         &kp C       &kp V      &kp B      &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp MINUS
&kp LCTRL         &kp LGUI      &kp LALT      &kp DEL     &mo 1      &kp SPACE  &kp ENTER  &kp RALT   &kp RCTRL  &kp K_BACK &kp K_FORWARD &mo 2
            >;
            sensor-bindings = <&scroll_v>, <&scroll_h>;
        };

        layer_1 {
            bindings = <
&kp F1            &kp F2        &kp F3        &kp F4      &kp F5     &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &kp EQUAL  &kp DEL
&kp A             &none         &none         &none       &none      &trans     &none      &none      &none      &trans     &kp F11    &kp F12
&trans            &none         &none         &none       &none      &trans     &mkp LCLK  &mkp RCLK  &trans     &trans     &trans     &trans
&trans            &trans        &trans        &trans      &x_admin   &pw_macro  &none      &none      &trans     &trans     &kp UP     &trans
&trans            &trans        &trans        &trans      &trans     &alt_ctrl_del &mkp LCLK &mkp RCLK &trans    &kp LEFT   &kp DOWN   &kp RIGHT
            >;
            sensor-bindings = <&scroll_v>, <&scroll_h>;
        };

        layer_2 {
            bindings = <
&trans            &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans    &trans     &trans     &trans     &trans     &kp W
&trans            &trans        &trans        &trans       &trans       &trans       &trans    &trans     &trans     &trans     &trans     &trans
&trans            &bt BT_CLR_ALL &trans       &trans       &trans       &trans       &trans    &trans     &trans     &trans     &trans     &trans
&trans            &trans        &trans        &bt BT_CLR   &trans       &trans       &bt BT_NXT &trans    &trans     &trans     &trans     &trans
&trans            &trans        &trans        &trans       &trans       &trans       &trans    &trans     &trans     &trans     &trans     &trans
            >;
            sensor-bindings = <&scroll_v>, <&scroll_h>;
        };

        layer_3 {
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&scroll_v>, <&scroll_h>;
        };

        layer_4 {
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&scroll_v>, <&scroll_h>;
        };
    };
};